# Directory for the CMS databases (created on first use)
DATA_PATH=./private
# Directory that caches uploaded files and image variants
ASSETS_DIRECTORY=./private/assets
# The site's address, which the links of `bananacms user create` and
# `user reset` go on
SERVER_URL=http://localhost:5173
# The lowest log level written: debug, info, warn or error (default: info)
# LOG_LEVEL=debug
