{
  "name": "@reeywhaar/bananacms",
  "version": "0.0.1-alpha.5",
  "description": "A CMS and React Server Components framework on Vite",
  "license": "ISC",
  "homepage": "https://github.com/Reeywhaar/bananacms/tree/newbanana#readme",
  "bugs": {
    "url": "https://github.com/Reeywhaar/bananacms/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Reeywhaar/bananacms.git",
    "directory": "cms"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "bin": {
    "bananacms": "./bin/bananacms.js"
  },
  "files": [
    "bin",
    "dist"
  ],
  "exports": {
    ".": {
      "bananacms-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./client": {
      "bananacms-source": "./src/client.ts",
      "types": "./dist/client.d.ts",
      "default": "./dist/client.js"
    },
    "./types": {
      "bananacms-source": "./src/types.d.ts",
      "types": "./dist/types.d.ts"
    },
    "./stores": {
      "bananacms-source": "./src/stores.ts",
      "types": "./dist/stores.d.ts",
      "default": "./dist/stores.js"
    }
  },
  "imports": {
    "#cms/*.ts": {
      "bananacms-source": "./src/*.ts",
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    },
    "#cms/*.tsx": {
      "bananacms-source": "./src/*.tsx",
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    }
  },
  "scripts": {
    "typecheck": "tsc",
    "build": "rm -rf dist && tsc -p tsconfig.build.json && node scripts/copy_build_files.ts",
    "prepack": "npm run build"
  },
  "peerDependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "dependencies": {
    "@badrap/valita": "^0.5.4",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource/roboto": "^5.3.0",
    "@libsql/client": "^0.18.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitejs/plugin-rsc": "^0.5.36",
    "commander": "^15.0.0",
    "disposablestack": "^1.1.8",
    "drizzle-orm": "^0.45.3",
    "json5": "^2.2.3",
    "marked": "^18.0.14",
    "music-metadata": "^11.16.1",
    "rsc-html-stream": "^0.0.8",
    "sharp": "^0.35.4",
    "srvx": "^1.0.5",
    "tailwindcss": "^4.3.3",
    "uuid": "^14.0.2",
    "vite": "^8.3.1"
  }
}
